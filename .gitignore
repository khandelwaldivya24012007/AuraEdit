# =========================
# AuraEdit - Git Ignore
# =========================

# Secrets / environment variables
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Generated user files
uploads/*
outputs/*

# Keep empty directories in Git
!uploads/.gitkeep
!outputs/.gitkeep

# IDE settings
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log